// Durable Object host for the ISR tag index.
//
// Deploy this BEFORE wrangler.toml: the app worker binds TAG_INDEX with
// `script_name = "drizzle-bench-isr"`, so this script has to exist first.
//
// The `migrations` tag below is coupled to the pinned `cloudflare-isr` commit in package.json.
// If a dependency bump changes the ISRTagIndexDO class, add a new migration tag here in the
// same change - see README.md.
{
	"name": "drizzle-bench-isr",
	"account_id": "8ce8bd9cb4d667a578aee91aa8dc5edd",
	"compatibility_date": "2025-03-01",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./isr-worker.ts",
	"durable_objects": {
		"bindings": [
			{
				"name": "TAG_INDEX",
				"class_name": "ISRTagIndexDO",
			},
		],
	},
	"migrations": [
		{
			"tag": "v2",
			"new_sqlite_classes": ["ISRTagIndexDO"],
		},
	],
}
