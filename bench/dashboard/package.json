{
	"name": "drizzle-bench-dashboard",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vp build",
		"preview": "vp preview",
		"check": "vp check && svelte-check --tsconfig ./tsconfig.json",
		"svelte:check": "svelte-check --tsconfig ./tsconfig.json",
		"cf:build": "vp build",
		"cf:dev": "vp build && wrangler dev",
		"cf:deploy": "vp build && wrangler deploy",
		"cf:types": "wrangler types src/cloudflare.d.ts",
		"api:types": "openapi-typescript ../../docs/benchmark-spec/openapi/bench-api.v1.yaml -o src/lib/api-types.d.ts"
	},
	"dependencies": {
		"effect": "^4.0.0-beta.102",
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@fontsource-variable/archivo": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/oxanium": "^5.3.0",
		"@fontsource-variable/source-serif-4": "^5.3.0",
		"@fontsource-variable/spline-sans-mono": "^5.3.0",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.28.0",
		"@opentelemetry/api": "^1.9.1",
		"@sveltejs/adapter-cloudflare": "8.0.0-next.6",
		"@sveltejs/kit": "3.0.0-next.23",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.1.8",
		"@types/node": "^26.1.2",
		"bits-ui": "^2.16.3",
		"clsx": "^2.1.1",
		"layerchart": "^2.0.0",
		"openapi-typescript": "^7.13.0",
		"shadcn-svelte": "^1.4.2",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.4",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.2.0",
		"vite-plus": "^0.2.6",
		"wrangler": "^4.116.0"
	},
	"packageManager": "bun@1.3.9"
}
