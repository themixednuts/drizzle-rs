{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bench.drizzle.rs/schema/summary.v1.schema.json",
  "title": "Summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "run_id",
    "suite",
    "target_id",
    "primary",
    "spread"
  ],
  "properties": {
    "version": {
      "const": "v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z_[a-f0-9]{7,40}_[a-z0-9-]+$"
    },
    "suite": {
      "type": "string",
      "enum": [
        "throughput-http"
      ]
    },
    "target_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "group": {
      "type": "string",
      "minLength": 1
    },
    "primary": {
      "type": "object",
      "additionalProperties": false,
      "description": "Cross-trial aggregate. Every field is the MEDIAN across trials of that trial's own aggregate, which itself covers only phase=hold buckets weighted by request count. The `avg` key names are historical; read them as `median`.",
      "required": [
        "rps",
        "latency",
        "cpu",
        "err"
      ],
      "properties": {
        "rps": {
          "$ref": "#/$defs/avg_peak"
        },
        "latency": {
          "type": "object",
          "additionalProperties": false,
          "description": "Percentiles are computed from the merged raw hold-phase samples of each trial, then medianed across trials. They are not medians of per-bucket percentiles.",
          "required": [
            "avg",
            "p90",
            "p95",
            "p99",
            "p999"
          ],
          "properties": {
            "avg": {
              "type": "number",
              "minimum": 0
            },
            "p50": {
              "type": "number",
              "minimum": 0,
              "description": "Measured median latency. Absent in artifacts written before p50 was recorded."
            },
            "p90": {
              "type": "number",
              "minimum": 0,
              "description": "Measured 90th percentile. Earlier runs interpolated this from avg and p95; that value was fabricated and is no longer produced."
            },
            "p95": {
              "type": "number",
              "minimum": 0
            },
            "p99": {
              "type": "number",
              "minimum": 0
            },
            "p999": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "cpu": {
          "$ref": "#/$defs/avg_peak"
        },
        "mem": {
          "$ref": "#/$defs/avg_peak"
        },
        "err": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Total hold-phase errors divided by total hold-phase requests, medianed across trials."
        }
      }
    },
    "spread": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trials",
        "aggregate",
        "rps",
        "p95",
        "variance"
      ],
      "properties": {
        "trials": {
          "type": "integer",
          "minimum": 1
        },
        "aggregate": {
          "type": "string",
          "description": "How per-trial values were combined into `primary`. Always `median` today.",
          "enum": [
            "median",
            "mean"
          ]
        },
        "rps": {
          "$ref": "#/$defs/range"
        },
        "p95": {
          "$ref": "#/$defs/range"
        },
        "variance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rps",
            "p95",
            "cpu",
            "err"
          ],
          "properties": {
            "rps": {
              "$ref": "#/$defs/variance_metric"
            },
            "p95": {
              "$ref": "#/$defs/variance_metric"
            },
            "cpu": {
              "$ref": "#/$defs/variance_metric"
            },
            "mem": {
              "$ref": "#/$defs/variance_metric"
            },
            "err": {
              "$ref": "#/$defs/variance_metric"
            }
          }
        },
        "boxplot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rps",
            "p95",
            "cpu",
            "err"
          ],
          "properties": {
            "rps": {
              "$ref": "#/$defs/box_metric"
            },
            "p95": {
              "$ref": "#/$defs/box_metric"
            },
            "cpu": {
              "$ref": "#/$defs/box_metric"
            },
            "mem": {
              "$ref": "#/$defs/box_metric"
            },
            "err": {
              "$ref": "#/$defs/box_metric"
            }
          }
        },
        "ci95": {
          "deprecated": true,
          "description": "Removed. A 512-resample bootstrap over 3-5 trials reports the resampling noise, not a confidence interval for the target. Use spread.rps / spread.p95 and spread.boxplot instead.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rps": {
              "$ref": "#/$defs/range"
            },
            "p95": {
              "$ref": "#/$defs/range"
            }
          }
        }
      }
    },
    "saturation": {
      "$ref": "#/$defs/saturation",
      "description": "Peak throughput under the workload's declared latency SLO. Emitted ONLY when the workload declared `saturation`; a paced run has no capacity number and the key is then absent, which consumers must render as \"not measured\" and never as zero. BREAKING: runs recorded before the saturation suite carry a `{knee_rps, knee_p95}` object here instead and no longer validate — that heuristic ran on paced workloads, where throughput is capped by the load generator's own sleep timer, so its \"knee\" described the sleep timer rather than the target. Those keys are gone rather than deprecated in place, so there is exactly one saturation concept in this artifact."
    }
  },
  "$defs": {
    "saturation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slo",
        "outcome",
        "curve"
      ],
      "properties": {
        "slo": {
          "type": "object",
          "additionalProperties": false,
          "description": "Copied from the workload. The headline is only meaningful quoted with it: \"peak throughput at p99 < 50 ms\".",
          "required": [
            "metric",
            "ms"
          ],
          "properties": {
            "metric": {
              "type": "string",
              "enum": [
                "p50",
                "p90",
                "p95",
                "p99"
              ]
            },
            "ms": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "outcome": {
          "type": "string",
          "description": "saturated: a peak step was found and a later step failed to qualify. slo_never_met: no step qualified — every one either breached the SLO or was disqualified by its error rate — so there is NO peak and none is reported. did_not_saturate: the last step still qualified, so the ramp ended before the knee; the top step is a lower bound, not a peak.",
          "enum": [
            "saturated",
            "slo_never_met",
            "did_not_saturate"
          ]
        },
        "peak": {
          "type": "object",
          "additionalProperties": false,
          "description": "The highest-concurrency step that met the SLO and stayed inside limits.err. Present if and only if outcome is `saturated`.",
          "required": [
            "concurrency",
            "rps",
            "latency",
            "cpu",
            "err"
          ],
          "properties": {
            "concurrency": {
              "type": "integer",
              "minimum": 1
            },
            "rps": {
              "type": "number",
              "minimum": 0
            },
            "latency": {
              "$ref": "#/$defs/step_latency"
            },
            "cpu": {
              "type": "number",
              "minimum": 0
            },
            "err": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "lower_bound_rps": {
          "type": "number",
          "minimum": 0,
          "description": "Throughput of the top step, which still met the SLO. Present if and only if outcome is `did_not_saturate`. Read as \"at least N req/s — knee not reached\"; presenting it as a peak would claim a limit that was never found."
        },
        "curve": {
          "type": "array",
          "minItems": 1,
          "description": "Every measured step, ascending by concurrency, breaches and disqualifications included. This is the throughput-vs-concurrency curve and it is what makes the headline checkable.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "concurrency",
              "rps",
              "latency",
              "err",
              "cpu",
              "slo_met",
              "disqualified"
            ],
            "properties": {
              "concurrency": {
                "type": "integer",
                "minimum": 1
              },
              "rps": {
                "type": "number",
                "minimum": 0
              },
              "latency": {
                "$ref": "#/$defs/step_latency"
              },
              "err": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "cpu": {
                "type": "number",
                "minimum": 0
              },
              "slo_met": {
                "type": "boolean"
              },
              "disqualified": {
                "type": ["string", "null"],
                "description": "Why this step can never be the peak, e.g. \"error rate 3.20% exceeds limit 1.00%\", or null. Always present so consumers can rely on the key; a disqualified step is still charted, never silently dropped."
              }
            }
          }
        }
      }
    },
    "step_latency": {
      "type": "object",
      "additionalProperties": false,
      "description": "Percentiles over the merged raw samples of that step's hold plateau, medianed across trials. Not a percentile of per-bucket percentiles.",
      "required": [
        "p50",
        "p90",
        "p95",
        "p99"
      ],
      "properties": {
        "p50": {
          "type": "number",
          "minimum": 0
        },
        "p90": {
          "type": "number",
          "minimum": 0
        },
        "p95": {
          "type": "number",
          "minimum": 0
        },
        "p99": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "avg_peak": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "avg",
        "peak"
      ],
      "properties": {
        "avg": {
          "type": "number",
          "minimum": 0
        },
        "peak": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    },
    "box_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "q1",
        "median",
        "q3",
        "max",
        "samples"
      ],
      "properties": {
        "min": {
          "type": "number",
          "minimum": 0
        },
        "q1": {
          "type": "number",
          "minimum": 0
        },
        "median": {
          "type": "number",
          "minimum": 0
        },
        "q3": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "minimum": 0
        },
        "samples": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "variance_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "stdev",
        "samples"
      ],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "stdev": {
          "type": "number",
          "minimum": 0
        },
        "samples": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
