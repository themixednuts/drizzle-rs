{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bench.drizzle.rs/schema/run-manifest.v1.schema.json",
  "title": "Run Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "run_id",
    "cohort_id",
    "name",
    "suite",
    "git",
    "workload",
    "targets",
    "target_meta",
    "queries",
    "start",
    "end",
    "status",
    "seed",
    "load",
    "dataset",
    "artifacts",
    "runner",
    "trials"
  ],
  "properties": {
    "version": {
      "const": "v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z_[a-f0-9]{7,40}_[a-z0-9-]+$"
    },
    "cohort_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "suite": {
      "type": "string",
      "enum": [
        "throughput-http"
      ]
    },
    "git": {
      "type": "string",
      "pattern": "^[a-f0-9]{7,40}$"
    },
    "workload": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "target_meta": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "lang",
          "runtime",
          "orm",
          "driver",
          "proc",
          "pool",
          "db",
          "wire",
          "fair",
          "contract"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "group": {
            "type": "string",
            "minLength": 1
          },
          "lang": {
            "type": "string",
            "enum": ["ts", "go", "rust", "other"]
          },
          "data_access": {
            "type": "string",
            "enum": ["sql-roundtrip", "in-process-cache"],
            "description": "How the target reaches its data. `in-process-cache` targets serve from a replicated local cache and are not comparable to SQL-roundtrip targets in a ranked table."
          },
          "sql_variant": {
            "type": "string",
            "minLength": 1,
            "description": "Free-form note describing an intentional deviation from the canonical SQL shape for a route."
          },
          "runtime": { "$ref": "#/$defs/name_ver" },
          "orm": { "$ref": "#/$defs/name_ver" },
          "driver": { "$ref": "#/$defs/driver" },
          "proc": { "$ref": "#/$defs/proc" },
          "pool": { "$ref": "#/$defs/pool" },
          "db": { "$ref": "#/$defs/db" },
          "wire": { "$ref": "#/$defs/wire" },
          "fair": { "$ref": "#/$defs/fair" },
          "contract": { "$ref": "#/$defs/contract" }
        }
      }
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "method", "path", "mix", "params", "sql"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "enum": ["GET"]
          },
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "mix": {
            "type": "integer",
            "minimum": 0
          },
          "params": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sql": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["dialect", "text"],
              "properties": {
                "dialect": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "start": {
      "type": "string",
      "format": "date-time"
    },
    "end": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "canceled",
        "partial"
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "load": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executor", "stages", "duration_s", "max_vus", "pacing", "requests"],
      "properties": {
        "executor": { "type": "string", "minLength": 1 },
        "stages": { "type": "integer", "minimum": 1 },
        "duration_s": { "type": "integer", "minimum": 1 },
        "max_vus": { "type": "integer", "minimum": 1 },
        "pacing": {
          "type": "string",
          "enum": ["drizzle-benchmark", "none"]
        },
        "requests": { "type": "integer", "minimum": 0 }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["customers", "employees", "orders", "suppliers", "products", "details_per_order"],
      "properties": {
        "customers": { "type": "integer", "minimum": 0 },
        "employees": { "type": "integer", "minimum": 0 },
        "orders": { "type": "integer", "minimum": 0 },
        "suppliers": { "type": "integer", "minimum": 0 },
        "products": { "type": "integer", "minimum": 0 },
        "details_per_order": { "type": "integer", "minimum": 0 }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "sums"
      ],
      "properties": {
        "base": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "report": {
          "type": "string",
          "minLength": 1
        },
        "sums": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "os",
        "cpu",
        "cores",
        "mem_gb",
        "metrics",
        "headroom",
        "topology"
      ],
      "properties": {
        "class": {
          "type": "string",
          "minLength": 1
        },
        "os": {
          "type": "string",
          "minLength": 1
        },
        "cpu": {
          "type": "string",
          "minLength": 1,
          "description": "Host CPU brand string as reported by the OS."
        },
        "cores": {
          "type": "integer",
          "minimum": 1,
          "description": "Logical cores available to the runner."
        },
        "cores_physical": {
          "type": "integer",
          "minimum": 1,
          "description": "Physical cores, when the OS reports them."
        },
        "mem_gb": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpu_scope",
            "memory_scope",
            "network_scope"
          ],
          "properties": {
            "cpu_scope": {
              "type": "string",
              "minLength": 1
            },
            "memory_scope": {
              "type": "string",
              "minLength": 1
            },
            "network_scope": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "headroom": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpu_peak"
          ],
          "properties": {
            "cpu_peak": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Peak utilisation of any single core. Diagnostic only: one saturated core on a many-core host does not mean the host was saturated."
            },
            "cpu_mean_peak": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Peak, across all samples, of CPU utilisation averaged over cores. This is what the publish headroom gate compares (fails at 85)."
            },
            "net_peak": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "topology": {
          "type": "object",
          "additionalProperties": false,
          "description": "Where the load generator, the target, and the database physically sit. Recorded so published numbers are read with the colocation in mind.",
          "required": [
            "loadgen_colocated",
            "db_colocated",
            "cpu_pinning"
          ],
          "properties": {
            "loadgen_colocated": {
              "type": "boolean",
              "description": "True when the load generator shares the host with the target. Always true today: the runner spawns every target as its own child."
            },
            "db_colocated": {
              "type": "boolean",
              "description": "True when the database also shares this host (absent or loopback DATABASE_URL)."
            },
            "cpu_pinning": {
              "type": ["string", "null"],
              "description": "Applied cpuset assignment (BENCH_CPUSET_LOAD / BENCH_CPUSET_SERVER), or null when nothing was pinned. Linux only."
            }
          }
        }
      }
    },
    "harness": {
      "type": "array",
      "description": "The harness each database family ran under, one entry per family in this run, sorted by family. Within a family the declared harness must be identical or the run fails, so every entry records a verified fact. Across families the values are free to differ — that difference IS the stack comparison — and they are recorded here so a reader cannot mistake a stack difference for a library one.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family", "within_family_identical"],
        "properties": {
          "family": { "type": "string", "minLength": 1 },
          "targets": {
            "type": "array",
            "description": "Targets whose declared harness was compared for equality. The runner always emits it; it is optional here because the contract mandates only `family` and `within_family_identical`.",
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
          },
          "workers": { "type": "integer", "minimum": 1 },
          "pool": { "type": "integer", "minimum": 1 },
          "tuning": { "type": "string", "minLength": 1 },
          "within_family_identical": {
            "type": "boolean",
            "description": "True when at least one target was compared and they all agreed. False only when there was nothing to compare (every target in the family is exempt), in which case workers/pool/tuning are absent. It is never false because drift was tolerated — drift fails the run."
          },
          "exempt": {
            "type": "array",
            "description": "Targets excluded from the equality check because their configuration is not comparable by design, e.g. an in-process cache with no connection pool. Listed rather than dropped.",
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
          }
        }
      }
    },
    "fairness": {
      "deprecated": true,
      "description": "Removed. Recorded within-run fairness mismatches as non-fatal warnings, which is silent in every way that matters: a warning buried in the manifest still let an unequal library comparison ship. Within-family drift is now a hard error and `harness` records the verified configuration instead. Kept so runs recorded before that change still validate.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "msg"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "msg": { "type": "string", "minLength": 1 }
        }
      }
    },
    "trials": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "aggregate"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "aggregate": {
          "type": "string",
          "description": "How per-trial values were combined into the published summary. Always `median` today.",
          "enum": [
            "median",
            "mean"
          ]
        }
      }
    }
  },
  "$defs": {
    "name_ver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "ver"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "ver": { "type": "string", "minLength": 1 }
      }
    },
    "driver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "ver"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "ver": { "type": "string", "minLength": 1 },
        "transport": { "type": "string", "minLength": 1 }
      }
    },
    "proc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "workers"],
      "properties": {
        "mode": { "type": "string", "enum": ["single", "multi"] },
        "workers": { "type": "integer", "minimum": 1 }
      }
    },
    "pool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max"],
      "properties": {
        "max": { "type": "integer", "minimum": 1 },
        "min": { "type": "integer", "minimum": 0 },
        "acquire_ms": { "type": "integer", "minimum": 1 }
      }
    },
    "db": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "hash"],
      "properties": {
        "profile": { "type": "string", "minLength": 1 },
        "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "prepared": {
          "type": "boolean",
          "description": "Whether the target uses server-side prepared statements."
        }
      }
    },
    "wire": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format"],
      "properties": {
        "format": { "type": "string", "enum": ["json", "text", "binary", "bsatn"] }
      }
    },
    "fair": {
      "type": "object",
      "additionalProperties": false,
      "description": "The target's own declaration, copied verbatim from its spec. The per-family verified view is `harness`; this is what each target claimed.",
      "required": ["workers", "pool", "db", "schema", "contract"],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "workers": { "type": "integer", "minimum": 1 },
        "pool": { "type": "integer", "minimum": 1 },
        "db": { "type": "string", "minLength": 1 },
        "schema": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "contract": { "type": "string", "minLength": 1 },
        "tuning": { "type": "string", "minLength": 1 }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ver"],
      "properties": {
        "ver": { "type": "string", "minLength": 1 }
      }
    }
  }
}
