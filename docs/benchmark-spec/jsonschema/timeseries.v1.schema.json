{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bench.drizzle.rs/schema/timeseries.v1.schema.json",
  "title": "Timeseries v1",
  "description": "Per-bucket measurements for one target. Points from every trial are concatenated into a single array; consumers must segment on point.trial rather than assume one continuous timeline.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "run_id",
    "suite",
    "target_id",
    "points"
  ],
  "properties": {
    "version": {
      "const": "v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z_[a-f0-9]{7,40}_[a-z0-9-]+$"
    },
    "suite": {
      "type": "string",
      "enum": [
        "throughput-http"
      ]
    },
    "target_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "interval_s": {
      "type": "integer",
      "minimum": 1,
      "deprecated": true,
      "description": "Deprecated alias for bucket_s, still emitted so existing consumers keep working. The name implied a single uninterrupted timeline, which was never true once trials were concatenated; use bucket_s plus per-point trial tags instead."
    },
    "bucket_s": {
      "type": "integer",
      "minimum": 1,
      "description": "Nominal sampling bucket length in seconds (workload.sampling.bucket_s). A bucket never straddles a stage or phase boundary, so the last bucket of a stage may be shorter."
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "time",
          "rps",
          "err",
          "latency",
          "cpu"
        ],
        "properties": {
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "rps": {
            "type": "number",
            "minimum": 0
          },
          "err": {
            "type": "number",
            "minimum": 0
          },
          "latency": {
            "$ref": "#/$defs/latency"
          },
          "cpu": {
            "type": "array",
            "minItems": 1,
            "description": "Per-core utilisation sampled on a dedicated thread at workload.sampling.cpu_ms. Host-wide: on a colocated run this includes the load generator and the database.",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "mem_mb": {
            "type": "number",
            "minimum": 0
          },
          "trial": {
            "type": "integer",
            "minimum": 0,
            "description": "Zero-based trial index this bucket came from."
          },
          "stage": {
            "type": "integer",
            "minimum": 0,
            "description": "Zero-based workload.stages index this bucket came from."
          },
          "phase": {
            "type": "string",
            "enum": [
              "warmup",
              "ramp",
              "hold"
            ],
            "description": "warmup = inside workload.warmup_s; ramp = VU count still interpolating; hold = sitting at the stage's declared VU count. Only hold buckets feed the primary aggregates."
          },
          "vus": {
            "type": "integer",
            "minimum": 0,
            "description": "Virtual users in flight during this bucket. Under pacing.mode=none there is no think time, so this is also the request concurrency — the x-axis of the saturation curve. Absent on aggregate points, which span several VU counts, and on artifacts written before it was recorded."
          },
          "requests": {
            "type": "integer",
            "minimum": 0,
            "description": "Requests completed inside this bucket. Used as the aggregation weight so a sparse bucket cannot outvote a busy one."
          },
          "queries": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method",
                "path",
                "rps",
                "err",
                "latency"
              ],
              "properties": {
                "method": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "pattern": "^/"
                },
                "rps": {
                  "type": "number",
                  "minimum": 0
                },
                "err": {
                  "type": "number",
                  "minimum": 0
                },
                "latency": {
                  "$ref": "#/$defs/latency"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "latency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "avg",
        "p95",
        "p99"
      ],
      "properties": {
        "avg": {
          "type": "number",
          "minimum": 0
        },
        "p50": {
          "type": "number",
          "minimum": 0,
          "description": "Measured median. Absent in artifacts written before p50/p90 were recorded."
        },
        "p90": {
          "type": "number",
          "minimum": 0,
          "description": "Measured 90th percentile."
        },
        "p95": {
          "type": "number",
          "minimum": 0
        },
        "p99": {
          "type": "number",
          "minimum": 0
        },
        "p999": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
