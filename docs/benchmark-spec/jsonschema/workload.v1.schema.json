{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bench.drizzle.rs/schema/workload.v1.schema.json",
  "title": "Workload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "suite",
    "name",
    "load",
    "data",
    "shape",
    "stages",
    "requests",
    "pacing",
    "sampling",
    "limits"
  ],
  "properties": {
    "version": {
      "const": "v1"
    },
    "suite": {
      "type": "string",
      "enum": [
        "throughput-http"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "load": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "executor",
        "unit",
        "concurrency"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "open",
            "closed"
          ]
        },
        "executor": {
          "type": "string",
          "description": "constant-vus holds each stage at its declared VU count. ramping-vus interpolates toward a stage's target when it differs from the previous stage. The arrival-rate executors are reserved names: the runner has no open-loop generator and rejects them.",
          "enum": [
            "constant-arrival-rate",
            "ramping-arrival-rate",
            "ramping-vus",
            "constant-vus"
          ]
        },
        "unit": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m)$"
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "seed",
        "schema"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "schema": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "endpoint"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "mixed",
            "single"
          ]
        },
        "endpoint": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "single"
              }
            }
          },
          "then": {
            "properties": {
              "endpoint": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "mixed"
              }
            }
          },
          "then": {
            "properties": {
              "endpoint": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sec"
        ],
        "properties": {
          "sec": {
            "type": "integer",
            "minimum": 1
          },
          "vus": {
            "type": "integer",
            "minimum": 1
          },
          "rps": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "oneOf": [
          {
            "required": [
              "vus"
            ]
          },
          {
            "required": [
              "rps"
            ]
          }
        ]
      }
    },
    "warmup_s": {
      "type": "integer",
      "minimum": 0,
      "description": "Leading seconds of the run tagged phase=warmup and excluded from primary aggregates (still emitted in the timeseries). Defaults to 10. A run shorter than its own warmup has no hold buckets, and the aggregate falls back to counting every bucket."
    },
    "requests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "file",
        "skip"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "generated",
            "file"
          ]
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "skip": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "pacing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "description": "drizzle-benchmark sleeps (iteration % 6) * 75ms after each request, per VU, matching the upstream k6 cadence (mean 187.5ms). This imposes a ceiling on offered load of roughly VUs / (mean think time + mean service time) requests per second: a paced run measures latency under a bounded arrival rate, NOT peak throughput. Use pacing.mode=none for saturation/throughput workloads.",
          "enum": [
            "drizzle-benchmark",
            "none"
          ]
        }
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_ms",
        "bucket_s"
      ],
      "properties": {
        "cpu_ms": {
          "type": "integer",
          "minimum": 50
        },
        "bucket_s": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "err"
      ],
      "properties": {
        "err": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "p95": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "cpu_mean_peak": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0,
          "maximum": 100,
          "description": "Optional hard ceiling on peak mean-across-cores CPU. Absent: the headroom gate is informational (skip) — closed-loop ramps saturate colocated hosts by design. Set only where genuine headroom is expected (dedicated load/SUT hosts)."
        }
      }
    },
    "saturation": {
      "type": "object",
      "additionalProperties": false,
      "description": "Declares this workload as a capacity measurement, producing `summary.saturation`. The steps are not listed here: they ARE the hold stages of `stages`, so the ramp has one definition and the spec cannot drift from what runs. The runner refuses the block unless `pacing.mode=none` (a paced run's throughput is capped by its own sleep timer, so it cannot measure capacity), `load.executor=ramping-vus` (each step must ramp in before it holds), `warmup_s` lands on a stage boundary (so no step is measured over part of its plateau), and the ramp has at least three steps whose concurrency strictly increases.",
      "required": [
        "slo"
      ],
      "properties": {
        "slo": {
          "type": "object",
          "additionalProperties": false,
          "description": "The latency ceiling a step must stay under to be eligible as the peak. The headline is always quoted with it attached — a throughput number without a latency bound is not a capacity claim.",
          "required": [
            "metric",
            "ms"
          ],
          "properties": {
            "metric": {
              "type": "string",
              "enum": [
                "p50",
                "p90",
                "p95",
                "p99"
              ]
            },
            "ms": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    }
  }
}
